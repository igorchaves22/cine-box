{
    "appId": "com.igor.cinebox",
    "productName": "CineBox",
    "directories": {
        "output": "release"
    },
    "files": ["dist/**/*", "!dist/**/*.map", "package.json"],
    "asarUnpack": ["**/node_modules/better-sqlite3/**/*"],
    "extraResources": [
        {
            "from": "src/main/database/migrations",
            "to": "migrations"
        }
    ],
    "electronLanguages": ["en-US"],
    "win": {
        "target": "nsis"
    },
    "nsis": {
        "oneClick": false,
        "allowToChangeInstallationDirectory": true,
        "perMachine": false
    }
}
